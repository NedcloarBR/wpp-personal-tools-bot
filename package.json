{
	"name": "wpp-personal-tools-bot",
	"description": "A simple Self WhatsApp bot ",
	"version": "1.0.0",
	"author": {
		"name": "Miguel Alexandre Uhlein <NedcloarBR>",
		"email": "nedcloar1@hotmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NedcloarBR/wpp-personal-tools-bot.git"
	},
	"bugs": {
		"url": "https://github.com/NedcloarBR/wpp-personal-tools-bot/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "yarn@4.3.1",
	"scripts": {
		"build": "nest build",
		"format": "biome format --write .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.24",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.24",
		"nestwhats": "^3.1.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"whatsapp-web.js": "^1.34.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@nedcloarbr/biome-config": "^2.1.0",
		"@nestjs/cli": "^11.0.21",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.24",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.40",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.2",
		"@types/supertest": "^7.2.0",
		"globals": "^17.6.0",
		"jest": "^30.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"ts-loader": "^9.6.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
